# ROS2 / colcon build artifacts — regenerated by `colcon build`, never commit these
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# Python
__pycache__/
*.pyc

# Vivado / Xilinx project artifacts (FPGA workstream)
*.jou
*.log
*.str
.Xil/
*.cache/
*.hw/
*.sim/
*.runs/

# Editor/OS junk
.vscode/
.DS_Store
ros2_ws/*.png

# Backup files from in-place edits
*.bak
*.bak2
*.bak3

# Generated URDF visualization output (regenerate via urdf_to_graphiz if needed)
ros2_ws/library_bot.gv
ros2_ws/library_bot.pdf
ros2_ws/src/library_bot_moveit_config/scripts/*.bak
*.orig
