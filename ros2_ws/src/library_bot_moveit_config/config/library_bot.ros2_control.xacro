<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    ros2_control block for library_bot.

    use_sim:=false (default) -> mock_components/GenericSystem: fake hardware
      that echoes commands back instantly. No Gazebo, no physics. Still
      used by move_group.launch.py for fast planning-only tests.
    use_sim:=true            -> gazebo_ros2_control/GazeboSystem: joints are
      driven inside real Gazebo physics (used by gazebo_moveit.launch.py).

    Real motors (steppers, per the plan doc) aren't wired to ROS2 control
    yet; swap this block for a real hardware plugin later without touching
    anything else in this package.
  -->
  <xacro:macro name="library_bot_ros2_control" params="name:=library_bot use_sim:=false">
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_sim}">
          <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_sim}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:unless>
      </hardware>
      <joint name="joint1_waist">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="joint2_shoulder">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="joint3_elbow">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="joint4_wrist1">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="joint5_wrist2">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="joint6_wrist3">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
