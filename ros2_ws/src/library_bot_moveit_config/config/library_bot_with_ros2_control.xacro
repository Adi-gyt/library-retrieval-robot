<?xml version="1.0"?>
<!--
  Wrapper around library_bot_description's own library_bot.urdf.xacro.

  Combines the real robot geometry with the ros2_control hardware
  interface macro (config/library_bot.ros2_control.xacro) so that the
  robot_description passed to ros2_control_node actually contains a
  <ros2_control> tag. This lives in library_bot_moveit_config rather than
  editing library_bot_description's own xacro file directly, keeping the
  mock-hardware-for-testing concern separate from the robot's real
  geometry description.
-->
<robot name="library_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find library_bot_description)/urdf/library_bot.urdf.xacro"/>
  <xacro:include filename="$(find library_bot_moveit_config)/config/library_bot.ros2_control.xacro"/>
  <xacro:library_bot_ros2_control/>
</robot>
