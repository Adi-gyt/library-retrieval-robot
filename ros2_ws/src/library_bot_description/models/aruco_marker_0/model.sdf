<?xml version="1.0"?>
<sdf version="1.6">
  <model name="aruco_marker_0">
    <!-- static: true means it doesn't fall/move under physics — it's a
         fixed prop in the world, not a robot part -->
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <!-- 1cm thick in X, 15cm square face — thick enough to avoid
             depth-camera rendering artifacts on razor-thin geometry
             (0.001m caused -inf/invalid depth reads at the marker's
             exact pixel location, even though it rendered fine in RGB) -->
        <geometry>
          <box>
            <size>0.01 0.15 0.15</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://aruco_marker_0/materials/scripts</uri>
            <uri>model://aruco_marker_0/materials/textures</uri>
            <name>ArucoMarker/Marker0</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>
