<?xml version="1.0"?>
<sdf version="1.6">
  <model name="tray_pedestal">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.25 0.25 0.45</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.25 0.25 0.45</size></box></geometry>
        <material><script>
          <uri>file://media/materials/scripts/gazebo.material</uri>
          <name>Gazebo/Wood</name>
        </script></material>
      </visual>
    </link>
  </model>
</sdf>
