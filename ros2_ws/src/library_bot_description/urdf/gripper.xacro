<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Parallel-jaw gripper. Fingers extend along +X of the parent, open along +/-Y.
       Finger joint 0 = closed, 0.065 = fully open (each side). -->

  <xacro:macro name="finger" params="side y axis">
    <link name="finger_${side}">
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1.56e-5" ixy="0" ixz="0" iyy="4.875e-5" iyz="0" izz="3.43e-5"/>
      </inertial>
      <visual><geometry><box size="0.09 0.012 0.06"/></geometry></visual>
      <collision><geometry><box size="0.09 0.012 0.06"/></geometry></collision>
    </link>
    <joint name="finger_${side}_joint" type="prismatic">
      <parent link="gripper_palm"/>
      <child link="finger_${side}"/>
      <origin xyz="0.062 ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 ${axis} 0"/>
      <limit lower="0.0" upper="0.065" effort="40" velocity="0.1"/>
    </joint>
    <gazebo reference="finger_${side}">
      <mu1>3.0</mu1>
      <mu2>3.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.1</maxVel>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="parallel_gripper" params="parent">
    <link name="gripper_palm">
      <inertial>
        <mass value="0.4"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1.163e-3" ixy="0" ixz="0" iyy="1.133e-4" iyz="0" izz="1.11e-3"/>
      </inertial>
      <visual><geometry><box size="0.03 0.18 0.05"/></geometry></visual>
      <collision><geometry><box size="0.03 0.18 0.05"/></geometry></collision>
    </link>
    <joint name="gripper_palm_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="gripper_palm"/>
      <origin xyz="0.03 0 0" rpy="0 0 0"/>
    </joint>

    <xacro:finger side="left"  y="0.008"  axis="1"/>
    <xacro:finger side="right" y="-0.008" axis="-1"/>

    <!-- Tool centre point: middle of the finger pads (0.092 m ahead of ee_link) -->
    <link name="grasp_tcp"/>
    <joint name="grasp_tcp_joint" type="fixed">
      <parent link="gripper_palm"/>
      <child link="grasp_tcp"/>
      <origin xyz="0.062 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
